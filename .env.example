# ───────────── Better Auth ─────────────
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Your site URL. Local: http://localhost:3000  |  Vercel: https://your-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# ───────────── Database ─────────────
# Leave empty locally -> a SQLite file is created at data/auth.sqlite.
# On Vercel you MUST set a PostgreSQL URL (e.g. free Neon / Supabase):
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ───────────── Social login (optional) ─────────────
# Google:  https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub:  https://github.com/settings/developers  (OAuth Apps -> New)
#   Authorization callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ───────────── Product API (optional override) ─────────────
# BAZARDOR_API=https://api.api-store.workers.dev/api/bazardor
